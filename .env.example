# Copy to .env and configure your own services.
# EXPO_PUBLIC_* values are embedded in the app and are NOT secrets.
EXPO_PUBLIC_API_ENV=development
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_LOCALHOST_PORT=3000
EXPO_PUBLIC_LOCALHOST_IP=
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use a publishable/anon client key, NEVER a service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional build configuration; use your own registered identifiers.
IOS_BUNDLE_IDENTIFIER=org.example.chathealth
ANDROID_PACKAGE=org.example.chathealth
EXPO_OWNER=
EAS_PROJECT_ID=
APP_LINK_DOMAIN=

# Server-side Apple OAuth helper only (never EXPO_PUBLIC_*).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICE_ID=
APPLE_PRIVATE_KEY_PATH=
# Optional notification integration test against your own backend.
TEST_JWT=
